# Email generation (+ RAGAS evaluation)
LLM_PROVIDER=anthropic
# LLM_MODEL=            # optional override (defaults: claude-opus-4-8 / gpt-4o / mistral-small-latest)

# Email categorization (triage). Falls back to LLM_* when unset.
CLASSIFY_LLM_PROVIDER=mistral
# CLASSIFY_LLM_MODEL=   # optional; defaults to that provider's default model

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional local embedding model override (sentence-transformers).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage (optional — default is local SQLite + filesystem, zero setup).
# STORAGE_STRUCTURED_PROVIDER=local   # local | postgres
# STORAGE_BLOB_PROVIDER=local         # local | s3 | azure | gcs | postgres
# STORAGE_POSTGRES_DSN=postgresql://user:pass@localhost:5432/app
# STORAGE_S3_BUCKET=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_AZURE_CONNECTION_STRING=
# STORAGE_AZURE_CONTAINER=app-data
# STORAGE_GCS_BUCKET=
